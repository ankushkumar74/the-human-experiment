# The Human Experiment — environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On Vercel, add these under Project → Settings → Environment Variables.

# ── Public site URL (used for share links, OG metadata, sitemap) ────────────
# Local: http://localhost:3000   Production: your Vercel or custom URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (REQUIRED) ─────────────────────────────────────────────────────
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Public "anon" key. Safe for the browser: it can only read the aggregate views.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_, never log it, never ship it to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ── Visitor identity (REQUIRED) ─────────────────────────────────────────────
# Secret used to sign the visitor cookie and to hash visitor IDs and IPs.
# Generate one:  openssl rand -base64 48
# Rotating it resets every visitor's identity (everyone may water once more).
VISITOR_COOKIE_SECRET=

# ── Cloudflare Turnstile (OPTIONAL — bot protection) ────────────────────────
# Enabled only when BOTH keys are set. Free: https://dash.cloudflare.com → Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── PostHog (OPTIONAL — analytics) ──────────────────────────────────────────
# Analytics is fully disabled when the key is empty.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
